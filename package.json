{
  "name": "hackaholics-financial-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "operator:password": "tsx scripts/password.ts",
    "payments:reconcile": "tsx --env-file-if-exists=.env.local scripts/reconcile.ts",
    "format": "prettier --write .",
    "test:http": "node scripts/http-smoke.mjs",
    "test:browser": "node scripts/browser-chat-payments.mjs",
    "test:browser:workspace": "node scripts/browser-workspace.mjs",
    "test:browser:approved-p0": "node scripts/browser-approved-p0.mjs",
    "verify:narration": "tsx scripts/verify-grounded-narration.ts",
    "test:integration": "vitest run tests/financial-integration tests/financial-agent/grounded-narration.test.ts tests/financial-agent/routing.test.ts tests/financial-agent/education.test.ts tests/financial-agent/date-window.test.ts tests/payments.test.ts tests/financial-safety.test.ts tests/voice.test.ts",
    "test:browser:integration": "node scripts/browser-integration.mjs",
    "test:browser:chat-payments": "node scripts/browser-chat-payments.mjs",
    "test:browser:legacy": "node scripts/browser-safety.mjs && node scripts/browser-chat-first.mjs && node scripts/browser-chat-ux.mjs && node scripts/browser-conversation.mjs && node scripts/browser-demo-polish.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@tailwindcss/postcss": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.4.1",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^5.0.4"
  },
  "type": "module"
}
