# Default is persistent embedded PostgreSQL, single Node process only.
DATABASE_URL=pglite://.data/agent
# Production: postgresql://user:password@host:5432/agent?sslmode=verify-full
APP_ORIGIN=http://localhost:3000
OPERATOR_ID=demo-operator
# Generate using npm run operator:password (password read from stdin).
OPERATOR_PASSWORD_HASH=
# fixture | test | live. Fixtures NEVER call Paystack.
PAYMENT_MODE=fixture
PAYSTACK_SECRET_KEY=
PAYSTACK_INTEGRATION_ID=
PAYSTACK_TRANSFERS_ENABLED=false
LIVE_OWNER_AUTHORIZED=false
LIVE_WEBHOOK_VALIDATED=false
LIVE_RECONCILIATION_VALIDATED=false
LIVE_TRANSFERS_ENABLED=false
PAYMENTS_EMERGENCY_DISABLED=false
# Strict live allowlist bank_code:account_number, separated by commas.
LIVE_BENEFICIARY_ALLOWLIST=
MAX_PAYMENT_KOBO=100000
MAX_BATCH_KOBO=500000
# Conservative estimate, NOT a confirmed provider fee. Override after checking pricing.
FEE_RESERVE_KOBO=5000
APP_TIMEZONE=Africa/Lagos
AI_PROVIDER=none
# none | openai | gemini
AI_API_KEY=
AI_MODEL=
